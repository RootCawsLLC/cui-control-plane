{
  "name": "cui-control-plane",
  "version": "0.1.0",
  "description": "One control inventory for a DoD CUI boundary, with five NDAA-driven regimes attached as crosswalk edges rather than five compliance programmes. Emits OSCAL O1-O5 with deterministic v5 UUIDs and derives the SPRS score from assertion records.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "RootCawsLLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RootCawsLLC/cui-control-plane.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ccp": "src/cli.mjs"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "prepare": "node scripts/setup-git.mjs",
    "setup": "node scripts/setup-git.mjs",
    "validate": "node src/cli.mjs validate",
    "coverage": "node src/cli.mjs coverage",
    "sprs": "node src/cli.mjs sprs --assertions fixtures/assertions --weights fixtures/sprs-weights.fixture.yaml",
    "emit": "node src/cli.mjs emit all --assertions fixtures/assertions --out out",
    "demo": "node scripts/demo.mjs",
    "variance": "node src/cli.mjs variance",
    "policy": "node src/cli.mjs policy",
    "representation:889": "node src/cli.mjs representation 889",
    "init": "node src/cli.mjs init",
    "doctor": "node src/cli.mjs doctor",
    "pipeline": "node src/cli.mjs pipeline"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.1",
    "duckdb": "^1.1.3"
  },
  "optionalDependencies": {
    "@aws-sdk/client-config-service": "^3.700.0",
    "@aws-sdk/client-iam": "^3.700.0",
    "@aws-sdk/client-identitystore": "^3.700.0",
    "@aws-sdk/client-sso-admin": "^3.700.0"
  }
}

node_modules/
out/

# SCF's licence (CC BY-ND) forbids publishing derivative content, so its OSCAL export is
# fetched locally and resolved at run time — never vendored. See docs/adr/0006.
reference/scf/*.json
reference/scf/*.xlsx

# A live 1260H snapshot or a real supplier master is customer data and does not belong in a
# public reference repository. Fixtures under fixtures/ are synthetic and are committed.
reference/1260h/*.snapshot.yaml
reference/supplier-master.yaml
.evidence/

# NIST's oscal-cli is bootstrapped from Maven Central by the `oscal` npm package at CI time and
# writes SARIF logs beside the checkout. Neither is ours to commit.
oscal-cli-sarif-log-*.json

# One organisation description, not a shared artifact. Create it with `npm run init`.
ccp.config.yaml
inbox/*
!inbox/.gitkeep
.warehouse/

# Terraform: lab-specific backend/vars and local state never go in a public repo.
examples/terraform/**/.terraform/
examples/terraform/**/.terraform.lock.hcl
examples/terraform/**/*.tfstate
examples/terraform/**/*.tfstate.*
examples/terraform/**/backend.hcl
examples/terraform/**/*.auto.tfvars
# Saved plans can embed resource values and are environment-specific.
examples/terraform/**/tfplan
examples/terraform/**/*.tfplan
